{
  "name": "rdelune-productions",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev -p 8084",
    "dev:productions": "node scripts/fetch-tracks.mjs && NEXT_DIST_DIR=.next-dev next dev -p 8084",
    "fetch-tracks": "node scripts/fetch-tracks.mjs",
    "build": "node scripts/fetch-tracks.mjs && NEXT_DIST_DIR=.next next build",
    "start": "NEXT_DIST_DIR=.next next start -p 8084",
    "lint": "eslint src/ functions/",
    "verify": "npm run lint && npm run build",
    "apply-productions-settings": "node scripts/apply-productions-settings.mjs"
  },
  "dependencies": {
    "@types/three": "^0.184.1",
    "lucide-react": "^1.16.0",
    "next": "^15.1.0",
    "q5": "^4.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "js-yaml": "^4.1.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "5.9.3"
  }
}
